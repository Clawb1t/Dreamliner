DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DATABASE_URL=file:./data/dreamliner.db
# Cap Node V8 heap (MB) for panel hosts with ~1GB RAM. Default 768.
# DREAMLINER_MAX_OLD_SPACE_MB=768
# Bot activity text (Discord shows this as "Watching …")
BOT_ACTIVITY=✈️ Airplanes
# Local `npm run dev` exports schema/ for the website editor. Force on/off:
# EXPORT_SCHEMA_ON_START=true
# EXPORT_SCHEMA_ON_START=false

# --- Website links (Discord buttons / docs) ---
# local = point users at your local Next.js site; prod = production site
DREAMLINER_ENV=local
DASHBOARD_URL_LOCAL=http://localhost:3000
DASHBOARD_URL_PROD=https://www.dreamliner.site

# --- Direct dashboard bridge (bot HTTP API the website calls) ---
# Shared secret — must match the website's DASHBOARD_BRIDGE_SECRET
DASHBOARD_BRIDGE_SECRET=
# Port the bot listens on (website uses BOT_BRIDGE_URL pointing here)
# Local default 4080 · PebbleHost production: 8179
DASHBOARD_BRIDGE_PORT=4080
# Set to false to disable the bridge HTTP server
DASHBOARD_ENABLED=true
# Optional extra Discord user IDs with platform dashboard access (comma-separated).
# Built-in owner ID is already in code; checked only after the bridge Bearer secret.
# DASHBOARD_SUPERUSER_IDS=
# Guild subscription SKU for Dreamliner Aero (Developer Portal → Monetization → SKUs)
# Var name stays DREAMLINER_ONE_SKU_ID — unchanged deployment config key.
DREAMLINER_ONE_SKU_ID=1537178843033501727

# --- Social Notifications (YouTube uploads) ---
# YouTube Data API v3 key (Google Cloud Console → enable "YouTube Data API v3" → Credentials).
# Required to resolve creator handles/URLs and poll for new uploads.
YOUTUBE_API_KEY=

# --- Text-to-speech (/tts) ---
# Runs on local Piper TTS (https://github.com/rhasspy/piper). Dreamliner installs the piper
# binary and a default voice into ./data/piper automatically on boot if they're missing — no
# setup needed for a fresh deploy. Everything below is optional, for overriding that default.
# Path to an existing piper executable, if you don't want it auto-installed.
# PIPER_BIN=
# Directory of voice model pairs (<id>.onnx + <id>.onnx.json), if you don't want the default location.
# PIPER_VOICES_DIR=
# Voice id (filename without .onnx) used when a guild hasn't set plugins.tts.config.voice.
# Defaults to en_US-lessac-medium, which is what gets auto-installed.
# PIPER_DEFAULT_VOICE=
